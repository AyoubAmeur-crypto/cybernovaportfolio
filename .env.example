# Maintenance Mode ("true" enables HTTP 503 + baby-pink maintenance screen; "false" serves full portfolio)
MAINTENANCE_MODE="true"
VITE_MAINTENANCE_MODE="true"

# Contact form recipient email exposed to client-side FormSubmit fallback
# Set to Salmaatouofficiel@gmail.com in production on Vercel
VITE_CONTACT_EMAIL="Salmaatouofficiel@gmail.com"

# Optional Vercel Serverless Email Delivery via Resend (/api/contact)
# If set in Vercel Environment Variables, /api/contact sends directly via Resend without FormSubmit activation
RESEND_API_KEY=""
CONTACT_TO_EMAIL="Salmaatouofficiel@gmail.com"
RESEND_FROM_EMAIL="Salma Atou Portfolio <onboarding@resend.dev>"
